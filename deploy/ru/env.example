# Переменные боевого сервера «Книги рода». Скопируйте в /etc/kniga-api.env на сервере, впишите значения. В git этот файл с настоящими значениями НЕ класть.
PORT=3000
REDIS_URL=redis://:ПАРОЛЬ_REDIS@127.0.0.1:6379
# Адрес сайта приложения без пути (можно несколько через запятую)
APP_ORIGINS=https://НОВЫЙ-АДРЕС.ru
# Длинные случайные строки (минимум 24 символа). ACCESS_SECRET нельзя менять: у всех оплативших пропадёт доступ.
ACCESS_SECRET=
CRON_SECRET=
# Альфа-Банк: сначала тестовый шлюз, потом боевой
ALFA_BASE_URL=https://alfa.rbsuat.com/payment/rest
ALFA_API_USER=
ALFA_API_PASSWORD=
ALFA_TAX_SYSTEM=
ALFA_VAT_TYPE=0
PRICE_RUB=2026
ACCESS_DAYS=365
# Пуши
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# ИИ выключен, пока AI_ENABLED не равен 1
AI_ENABLED=0

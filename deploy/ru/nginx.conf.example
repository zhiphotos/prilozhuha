# nginx для российского сервера. Замените НОВЫЙ-АДРЕС.ru. Сертификат: certbot --nginx -d НОВЫЙ-АДРЕС.ru
server {
    listen 80;
    server_name НОВЫЙ-АДРЕС.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name НОВЫЙ-АДРЕС.ru;
    # ssl_certificate и ssl_certificate_key добавит certbot

    root /var/www/kniga/site;
    index index.html;
    client_max_body_size 4m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # API: Node-процесс на 127.0.0.1:3100; адрес клиента для лимитов передаётся заголовком
    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # Файлы приложения: хэшированные сборки кэшируем надолго, страницу и service worker нет
    # Лендинг на главной (/), приложение по /app/. Хэшированные сборки кэшируем надолго, страницы и service worker нет
    location ^~ /app/assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
    location = /app/index.html { add_header Cache-Control "no-cache"; }
    location = /app/push-sw.js { add_header Cache-Control "no-cache"; }
    location = /app/manifest.webmanifest { add_header Cache-Control "no-cache"; }
    location /app/ { try_files $uri $uri/ /app/index.html; }
    location ^~ /media/ { add_header Cache-Control "public, max-age=604800"; try_files $uri =404; }
    location ^~ /fonts/ { add_header Cache-Control "public, max-age=604800"; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location = /landing.css { add_header Cache-Control "no-cache"; }
    location = /landing.js { add_header Cache-Control "no-cache"; }
    location = /config.js { add_header Cache-Control "no-cache"; }
    location = /push-sw.js { add_header Cache-Control "no-cache"; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
}
